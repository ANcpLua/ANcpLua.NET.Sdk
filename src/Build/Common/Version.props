<Project>
  <!--
    ANcpSdkPackageVersion is a placeholder stamped at pack time by build.ps1 from the
    CI-computed version (see .github/workflows/nuget-publish.yml compute_version job).
    Do not set a real version here — the placeholder is intentional.
  -->
  <PropertyGroup Label="SDK Version (Auto-generated)">
    <ANcpSdkPackageVersion>999.9.9</ANcpSdkPackageVersion>
  </PropertyGroup>

  <PropertyGroup Label=".NET SDK">
    <DotNetSdkVersion>10.0.400</DotNetSdkVersion>
    <DotNetSdkRollForward>latestMinor</DotNetSdkRollForward>
  </PropertyGroup>

  <PropertyGroup Label="Roslyn">
    <RoslynVersion>5.9.0</RoslynVersion>
    <RoslynAnalyzersVersion>5.9.0</RoslynAnalyzersVersion>
  </PropertyGroup>

  <PropertyGroup Label="Reference Assemblies">
    <BasicReferenceAssembliesVersion>1.8.11</BasicReferenceAssembliesVersion>
  </PropertyGroup>

  <PropertyGroup Label="Meziantou">
    <MeziantouFrameworkVersion>6.0.4</MeziantouFrameworkVersion>
    <MeziantouFullPathVersion>3.0.4</MeziantouFullPathVersion>
    <MeziantouProcessWrapperVersion>2.0.4</MeziantouProcessWrapperVersion>
    <MeziantouTemporaryDirectoryVersion>3.0.4</MeziantouTemporaryDirectoryVersion>
  </PropertyGroup>

  <PropertyGroup Label="Testing">
    <XunitV3Version>4.0.0</XunitV3Version>
    <AwesomeAssertionsVersion>9.6.0</AwesomeAssertionsVersion>
    <AwesomeAssertionsAnalyzersVersion>9.0.8</AwesomeAssertionsAnalyzersVersion>
  </PropertyGroup>

  <PropertyGroup Label="MTP Extensions">
    <MTPExtensionsVersion>2.4.0</MTPExtensionsVersion>
    <CodeCoverageVersion>18.11.0</CodeCoverageVersion>
    <GitHubActionsLoggerMTPVersion>3.0.5</GitHubActionsLoggerMTPVersion>
  </PropertyGroup>

  <PropertyGroup Label="Analyzers">
    <!-- 2.1.4: AL1012 no longer fires on using / await using declarations (its code fix
         dropped the dispose). Point truth only at an indexed version: an unpublished one
         fails every restore with NU1102.
         Bundled per-rule editorconfig in src/Config/Analyzer.ANcpLua.Analyzers.editorconfig
         is regenerated from the published DLL's HelpLinkUri by ConfigFilesGenerator. -->
    <ANcpLuaAnalyzersVersion>2.1.4</ANcpLuaAnalyzersVersion>
    <NetAnalyzersVersion Condition="'$(NetAnalyzersVersion)' == ''">$(DotNetSdkVersion)</NetAnalyzersVersion>
    <SbomTargetsVersion>4.1.5</SbomTargetsVersion>
    <BannedApiAnalyzersVersion>5.6.0</BannedApiAnalyzersVersion>
  </PropertyGroup>

  <PropertyGroup Label="Microsoft.Extensions">
    <MicrosoftExtensionsVersion>10.9.0</MicrosoftExtensionsVersion>
    <!-- The .NET runtime servicing line: one value for every package that ships with it. -->
    <DotNetRuntimeVersion>10.0.13</DotNetRuntimeVersion>
    <AspNetCoreVersion>$(DotNetRuntimeVersion)</AspNetCoreVersion>
    <MicrosoftBclAsyncInterfacesVersion>$(DotNetRuntimeVersion)</MicrosoftBclAsyncInterfacesVersion>
    <!-- Transitive security pin on the runtime line: NuGet.Packaging (via Microsoft.CodeAnalysis.Analyzer.Testing)
         pulls 8.0.1 / 9.0.6, hit by GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx; the servicing build carries the fixes. -->
    <SystemSecurityCryptographyPkcsVersion>$(DotNetRuntimeVersion)</SystemSecurityCryptographyPkcsVersion>
  </PropertyGroup>

  <PropertyGroup Label="Build Tools">
    <NuGetVersion>7.9.0</NuGetVersion>
    <MSBuildStructuredLoggerVersion>2.3.246</MSBuildStructuredLoggerVersion>
  </PropertyGroup>

  <!--
    Microsoft.Agents.AI (MAF 1.20.0). Numeric base ships in lockstep from upstream;
    family spans mixed release tracks — highest experimental track per package:
      stable     : core, Abstractions, Workflows, OpenAI, Workflows.Declarative
      -preview.* : Hosting, Hosting.AGUI.AspNetCore, Anthropic, DevUI
    Mismatched numeric bases break assembly binding. Mismatched tracks within
    the same numeric base are what upstream actually ships — keep aligned, accept
    the suffix variance.
  -->
  <PropertyGroup Label="Microsoft.Agents">
    <MicrosoftAgentsAIVersion Condition="'$(MicrosoftAgentsAIVersion)' == ''">1.20.0</MicrosoftAgentsAIVersion>
    <MicrosoftAgentsAIAbstractionsVersion Condition="'$(MicrosoftAgentsAIAbstractionsVersion)' == ''">1.20.0</MicrosoftAgentsAIAbstractionsVersion>
    <MicrosoftAgentsAIWorkflowsVersion Condition="'$(MicrosoftAgentsAIWorkflowsVersion)' == ''">1.20.0</MicrosoftAgentsAIWorkflowsVersion>
    <MicrosoftAgentsAIOpenAIVersion Condition="'$(MicrosoftAgentsAIOpenAIVersion)' == ''">1.20.0</MicrosoftAgentsAIOpenAIVersion>
    <MicrosoftAgentsAIHostingVersion Condition="'$(MicrosoftAgentsAIHostingVersion)' == ''">1.20.0-preview.260831.1</MicrosoftAgentsAIHostingVersion>
    <MicrosoftAgentsAIHostingAGUIAspNetCoreVersion Condition="'$(MicrosoftAgentsAIHostingAGUIAspNetCoreVersion)' == ''">1.20.0-preview.260831.1</MicrosoftAgentsAIHostingAGUIAspNetCoreVersion>
    <MicrosoftAgentsAIAnthropicVersion Condition="'$(MicrosoftAgentsAIAnthropicVersion)' == ''">1.20.0-preview.260831.1</MicrosoftAgentsAIAnthropicVersion>
    <MicrosoftAgentsAIDevUIVersion Condition="'$(MicrosoftAgentsAIDevUIVersion)' == ''">1.20.0-preview.260831.1</MicrosoftAgentsAIDevUIVersion>
    <MicrosoftAgentsAIWorkflowsDeclarativeVersion Condition="'$(MicrosoftAgentsAIWorkflowsDeclarativeVersion)' == ''">1.20.0</MicrosoftAgentsAIWorkflowsDeclarativeVersion>
  </PropertyGroup>

  <PropertyGroup Label="Aliases">
    <XunitMtpVersion>$(XunitV3Version)</XunitMtpVersion>
  </PropertyGroup>
</Project>
